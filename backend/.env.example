# CampusVerse Backend — Development Environment Template

PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campus_verse_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/campus_verse_db?schema=public"
JWT_SECRET="campusverse_super_secure_jwt_secret_key_2026_dev"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="*"

# OTP Configuration (Mock for development)
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_EMAIL_PROVIDER="mock"
OTP_FROM_EMAIL="noreply@campusverse.edu"
OTP_FROM_NAME="CampusVerse"

# Optional External Keys for Local Testing
