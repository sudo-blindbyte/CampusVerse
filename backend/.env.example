SENDGRID_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE=false

GEMINI_API_KEY=""

# Payment Gateway Configuration (Sandbox/Test Placeholders)
